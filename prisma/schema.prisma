// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// 1.0 Catálogos de apoyo (Rubro, Unidad, Marca)
//
model Rubro {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]  // Relación con productos
}

model Unidad {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]  // Relación con productos
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]  // Relación con productos
}

//
// 1.1 Productos
//
model Producto {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
  rubroId       Int
  marcaId       Int
  unidadId      Int
  precioCompra  Float
  precioVenta   Float
  estado        Boolean  @default(true) // true = Activo, false = Inactivo

  rubro   Rubro   @relation(fields: [rubroId], references: [id])
  marca   Marca   @relation(fields: [marcaId], references: [id])
  unidad  Unidad  @relation(fields: [unidadId], references: [id])

  stockProductos StockPorDeposito[]  // Relación con stock en depósitos

  @@index([estado], name: "idx_producto_estado")
  @@index([nombre, rubroId], name: "idx_producto_nombre_rubro")
}

//
// 2.0 Depósito
//
model Deposito {
  id          Int              @id @default(autoincrement())
  nombre      String
  ubicacion   String
  tipo        String           // Principal, Sucursal, Temporal, Tránsito
  capacidad   Int?             // Representada en m2
  estado      Boolean          @default(true)

  stock       StockPorDeposito[]   // Inventario de productos en este depósito
  movimientos MovimientoStock[]
}

//
// 2.1 Stock por Depósito
//
model StockPorDeposito {
  id              Int       @id @default(autoincrement())
  productoId      Int
  depositoId      Int
  stockActual     Int       @default(0)
  stockMinimo     Int       @default(0)
  stockMaximo     Int?
  capacidadMaxima Int?

  producto Producto @relation(fields: [productoId], references: [id])
  deposito Deposito @relation(fields: [depositoId], references: [id])

  @@unique([productoId, depositoId]) // un producto único por depósito

  detallesMovimiento DetalleMovimiento[]
}

//
// 2.2 Movimientos de Stock
//
model MovimientoStock {
  id                Int       @id @default(autoincrement())
  depositoId        Int
  tipoMovimientoId  Int
  tipoComprobanteId Int
  fecha             DateTime  @default(now())
  hora              DateTime  @default(now())

  deposito        Deposito        @relation(fields: [depositoId], references: [id])
  tipoMovimiento  TipoMovimiento  @relation(fields: [tipoMovimientoId], references: [id])
  tipoComprobante TipoComprobante @relation(fields: [tipoComprobanteId], references: [id])
  detalles        DetalleMovimiento[]
}

//
// 2.2.4 Detalle de Movimiento
//
model DetalleMovimiento {
  id            Int             @id @default(autoincrement())
  movimientoId  Int
  stockId       Int
  cantidad      Int

  movimiento MovimientoStock @relation(fields: [movimientoId], references: [id])
  stock      StockPorDeposito @relation(fields: [stockId], references: [id])
}

//
// 2.2.5 Tipos de Comprobante
//
model TipoComprobante {
  id          Int              @id @default(autoincrement())
  nombre      String            // Remito - Factura - Orden de Compra
  movimientos MovimientoStock[]
}

//
// 2.2.6 Tipos de Movimiento
//
model TipoMovimiento {
  id            Int              @id @default(autoincrement())
  nombre        String           // Ej: "Ingreso", "Egreso"
  ingresoEgreso Boolean          // true = ingreso, false = egreso
  movimientos   MovimientoStock[]
}