generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rubro {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]
}

model Unidad {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]
}

model Producto {
  id             Int                @id @default(autoincrement())
  nombre         String
  descripcion    String?
  rubroId        Int
  marcaId        Int
  unidadId       Int
  estado         Boolean            @default(true)

  marca          Marca              @relation(fields: [marcaId], references: [id])
  rubro          Rubro              @relation(fields: [rubroId], references: [id])
  unidad         Unidad             @relation(fields: [unidadId], references: [id])
  
  stockProductos StockPorDeposito[]
  detalleMovimiento       DetalleMovimiento[]
  detalleComprobanteProv  DetalleComprobanteProveedor[]
  detalleOrdenCompra      DetalleOrdenCompra[]

  @@index([estado], map: "idx_producto_estado")
  @@index([nombre, rubroId], map: "idx_producto_nombre_rubro")
}

model Deposito {
  id          Int                @id @default(autoincrement())
  nombre      String
  ubicacion   String
  tipo        String
  capacidad   Int?
  estado      Boolean            @default(true)
  ciudad      String?
  provincia   String?

  movimientos MovimientoStock[]
  stock       StockPorDeposito[]
}

model StockPorDeposito {
  id                 Int                 @id @default(autoincrement())
  productoId         Int
  depositoId         Int
  stockActual        Int                 @default(0)
  stockMinimo        Int                 @default(0)
  stockMaximo        Int?
  capacidadMaxima    Int?
  
  deposito           Deposito            @relation(fields: [depositoId], references: [id])
  producto           Producto            @relation(fields: [productoId], references: [id])

  @@unique([productoId, depositoId])
}

model MovimientoStock {
  id                Int                 @id @default(autoincrement())
  depositoId        Int
  tipoMovimientoId  Int
  tipoComprobanteId Int
  numeroComprobante  String?
  fecha             DateTime            @default(now())
  hora              DateTime            @default(now())


  detalles          DetalleMovimiento[]

  deposito          Deposito            @relation(fields: [depositoId], references: [id])
  tipoComprobante   TipoComprobante     @relation(fields: [tipoComprobanteId], references: [id])
  tipoMovimiento    TipoMovimiento      @relation(fields: [tipoMovimientoId], references: [id])
}

model DetalleMovimiento {
  id           Int             @id @default(autoincrement())
  movimientoId Int
  productoId   Int
  productoId   Int
  stockId      Int
  cantidad     Int


  movimiento   MovimientoStock  @relation(fields: [movimientoId], references: [id])
  producto   Producto       @relation(fields: [productoId], references: [id])

}


model TipoComprobante {
  id                   Int                    @id @default(autoincrement())
  nombre               String
  ComprobanteProveedor ComprobanteProveedor[]
  movimientos          MovimientoStock[]
}

model TipoMovimiento {
  id          Int               @id @default(autoincrement())
  nombre      String

  movimientos MovimientoStock[]
  comprobantes ComprobanteProveedor[]
}

model TipoMovimiento {
  id            Int               @id @default(autoincrement())
  nombre        String
  saldo         Boolean

  movimientos   MovimientoStock[]
}

model ComprobanteProveedor {
  id              Int       @id @default(autoincrement())
  ordenCompraId   Int
  proveedorId     Int
  letra           String?
  numeroSucursal  String?
  numero          String?
  tipoComprobanteId Int
  fecha           DateTime
  hora            String?
  total           Float?
  saldo           Float?
  metodoPagoId    Int?
  estado          Boolean   @default(true)
  observaciones   String?
  tipoMovimientoId Int?

  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  proveedor        Proveedores @relation(fields: [proveedorId], references: [id])
  tipoComprobante  TipoComprobante @relation(fields: [tipoComprobanteId], references: [id])
  metodoPago       MetodoPago? @relation(fields: [metodoPagoId], references: [id])
  
  detalleComprobante DetalleComprobanteProveedor[]
}

model DetalleComprobanteProveedor {
  id                      Int       @id @default(autoincrement())
  comprobanteProveedorId  Int
  productoId              Int
  precioUnitario          Float
  cantidad                Int
  descuento               Float?
  precioXCantidad         Float?
  observaciones           String?

  comprobanteProveedor  ComprobanteProveedor @relation(fields: [comprobanteProveedorId], references: [id])
  producto              Producto   @relation(fields: [productoId], references: [id])
}

model OrdenCompra {
  id           Int       @id @default(autoincrement())
  fecha        DateTime
  hora         String?
  nroOC        String?
  proveedorId  Int
  subTotal     Float?
  otrosGastos  Float?
  total        Float?
  fechaEntrega DateTime?
  depositoId   Int?
  estado       Boolean   @default(true)
  observaciones String?

  proveedor    Proveedores @relation(fields: [proveedorId], references: [id])
  detalleOrdenCompra DetalleOrdenCompra[]
  comprobantes ComprobanteProveedor[]
}

model DetalleOrdenCompra {
  id            Int       @id @default(autoincrement())
  ordenCompraId Int
  productoId    Int
  precioUnitario Float
  cantidad      Int

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  producto    Producto   @relation(fields: [productoId], references: [id])
}

model Proveedores {
  id               Int       @id @default(autoincrement())
  razonSocial       String?
  nombre            String
  nombreComercial   String?
  codigo             String?
  genero            String?
  categoriaFiscalId Int?
  cuil              String?
  pais              String?
  provincia         String?
  localidad         String?
  barrio            String?
  codigoPostal      String?
  telefono          String?
  paginaWeb         String?
  correoElectronico String?

  ordenesCompra   OrdenCompra[]
  comprobantes    ComprobanteProveedor[]
}

model MetodoPago {
  id     Int    @id @default(autoincrement())
  nombre String

  comprobantes ComprobanteProveedor[]
}
